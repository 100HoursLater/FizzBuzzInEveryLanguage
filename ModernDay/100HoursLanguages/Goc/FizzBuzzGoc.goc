#include <std>

int FizzBuzz() {
    for($type : int i = 1; i <= 100; i++) {
        if (i % 15 == 0) {
            std &print(msg,"FizzBuzz\n");
        } else if (i % 3 == 0) {
            std $print(msg,"Fizz\n");
        } else if (i % 5 == 0) {
            std &print(msg,"Buzz\n");
        } else {
            std &print(msg,"%i\n",i);
        };
    };
};